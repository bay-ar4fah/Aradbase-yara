import "pe"

rule MAL_WannacryDropper_MSIL_c34af1f1 {
    meta:
        description = "Detects Wannacry payload and Defender evasion artifacts"
        author = "bay-ar4fah"
        date = "2026-03-19"
        malware_family = "AsyncRAT"
     
    strings:
        $internal_name = "service.exe" ascii wide nocase
        
        $drop_name1 = "System.exe" ascii wide nocase
        $drop_name2 = "Install.exe" ascii wide nocase
        $kanji_art = "\xe9\x87\x91" 
        
        $evasion1 = "Add-MpPreference" ascii wide nocase
        $evasion2 = "-ExclusionPath" ascii wide nocase

    condition:
        uint16(0) == 0x5a4d 
        and filesize < 10MB 
        and (
            (
                pe.imphash() == "f34d5f2d4577ed6d9ceec516c1f5a744" and 
                (
                    $internal_name or 
                    $kanji_art
                )
            )
            or (
                $evasion1 and 
                $evasion2 and 
                any of ($drop_name*)
            )
        )
}
